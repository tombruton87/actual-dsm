# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=5006
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=https://192.168.1.10:5006    # https: Actual needs it
SSL_PROXY=0                          # 1 behind DSM's reverse proxy (which then does HTTPS)
AB_IMAGE=actualbudget/actual-server:latest
TLS=dsm                              # dsm | self | off (off only behind DSM's reverse proxy)
TLS_SOURCE=dsm                       # what's really in use: dsm, or self when DSM's certificate isn't found
TLS_CERT=/data/tls/fullchain.pem
TLS_KEY=/data/tls/privkey.pem
LIMIT_MB=20                          # the biggest budget file a device may upload
STALE_DAYS=14                        # a DSM notification when no budget has synced for this long; 0 = never
